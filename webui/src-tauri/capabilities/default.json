{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.openai.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://api.linkup.so/*" }
      ]
    }
  ]
}
